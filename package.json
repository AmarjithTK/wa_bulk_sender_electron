{
  "name": "whatsapp-sender-gui",
  "version": "1.1.9",
  "description": "Desktop WhatsApp bulk sender with multi-session campaigns",
  "main": "main.js",
  "author": "AmarjithTK",
  "scripts": {
    "start": "npm run build:ui && electron .",
    "dev:ui": "vite --host 127.0.0.1",
    "build:ui": "vite build",
    "browser:install": "puppeteer browsers install chrome",
    "test": "node --test tests/*.test.cjs",
    "build": "npm run build:ui && npm run browser:install && electron-builder --publish never",
    "build:win": "npm run build:ui && npm run browser:install && electron-builder --win --publish never",
    "build:mac": "npm run build:ui && npm run browser:install && electron-builder --mac --publish never",
    "build:linux": "npm run build:ui && npm run browser:install && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "whatsapp-web.js": "^1.34.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^7.0.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.sinspire.whatsbulk",
    "productName": "WhatsApp Message Sender",
    "icon": "assets/iconkitchen/web/icon-512.png",
    "copyright": "Copyright (c) 2026 AmarjithTK",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "extraResources": [{ "from": "browser", "to": "browser" }],
    "files": [
      "**/*",
      "!browser/**/*",
      "!src/**/*",
      "!tests/**/*",
      "!.wwebjs_cache/**/*",
      "!build.sh",
      "!.gitignore"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "title": "WhatsApp Message Sender ${version}",
      "background": "assets/showcase1.png",
      "icon": "assets/iconkitchen/web/icon-512.png",
      "window": {
        "width": 640,
        "height": 420
      },
      "contents": [
        {
          "x": 180,
          "y": 210,
          "type": "file"
        },
        {
          "x": 460,
          "y": 210,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "assets/iconkitchen/web/icon-512.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "WhatsApp Message Sender",
      "uninstallDisplayName": "WhatsApp Message Sender",
      "displayLanguageSelector": true,
      "license": "LICENSE_INSTALLER.txt"
    },
    "linux": {
      "category": "Utility",
      "maintainer": "AmarjithTK amarjithraveendran@gmail.com",
      "icon": "assets/iconkitchen/web/icon-512.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
